{
  "name": "tune-every-string",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "i18n:status": "npm run i18n:check && i18next-cli status",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "i18n:generate": "node scripts/check-i18n.mjs --write",
    "i18n:check": "node scripts/check-i18n.mjs",
    "build:production": "npm run build && node scripts/build-pages.mjs",
    "test:pitch": "vitest run src/tuning/PitchQuality.test.ts src/tuning/RecordedPitchQuality.test.ts src/tuning/BundledRecordedPitchQuality.test.ts src/tuning/IndependentSpectralReference.test.ts src/tuning/RecordedPitchRegression.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:pitch:recorded": "node scripts/run-recorded-pitch.mjs",
    "pitch:prepare-recordings": "node scripts/prepare-pitch-recordings.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "i18next": "26.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.3",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "i18next-cli": "1.75.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
